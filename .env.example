APP_NAME="SIPORA v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use dedicated databases; never point destructive commands at legacy data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipora_v2
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Binary-compatible database session handler. Production requires HTTPS/secure cookies.
SESSION_DRIVER=binary-database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=private
BROADCAST_CONNECTION=log

# Local mail is written to storage/logs. Set SMTP credentials locally for delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Google login. Register this exact callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Required for live manual auth; missing secrets fail closed. Tests use fakes.
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HTTP_PROXY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_HOSTNAME=localhost
RECAPTCHA_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_ACTION_REGISTER=register
RECAPTCHA_ACTION_LOGIN=login
RECAPTCHA_ACTION_FORGOT_PASSWORD=forgot_password

VITE_APP_NAME="${APP_NAME}"
