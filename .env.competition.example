# Offline demonstration on an isolated laptop only. Never deploy this profile.
# The bypass already implemented by SIPORA permits only local/testing, not competition.
APP_NAME="SIPORA v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Restore the prepared demo SQL into this NEW dedicated database first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipora_competition
DB_USERNAME=CHANGE_ME
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=binary-database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=private
BROADCAST_CONNECTION=log

# No external delivery. Use prepared verified accounts for the main demo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Google OAuth is optional online functionality; keep credentials out of this template.
FEATURE_GOOGLE_OAUTH=false
FEATURE_RECAPTCHA=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Explicit local-only offline setting; production continues to fail closed.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HTTP_PROXY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_HOSTNAME=127.0.0.1
RECAPTCHA_HOSTNAMES=localhost,127.0.0.1,sipora-v2.test
RECAPTCHA_ACTION_REGISTER=register
RECAPTCHA_ACTION_LOGIN=login
RECAPTCHA_ACTION_FORGOT_PASSWORD=forgot_password

# Optional online contact embed omitted; no address/coordinates are invented.
SIPORA_CONTACT_MAPS_EMBED_URL=
SIPORA_CONTACT_MAPS_URL=
VITE_APP_NAME="${APP_NAME}"
